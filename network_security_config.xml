<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Для отладки в локальной сети: разрешаем HTTP для всех доменов -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
